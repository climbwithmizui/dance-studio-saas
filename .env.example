# dance_saas 環境変数サンプル
# このファイルをコピーして .env を作成し、実際の値を設定してください。
#   cp .env.example .env
# ※ .env は .gitignore 済み（実際の値は絶対にコミットしないこと）

# データベース接続 URL（Neon Postgres など）。未設定時はローカルの SQLite にフォールバック。
# 例: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Flask セッション署名用シークレット。本番では必ずランダムな値に差し替えること。
SECRET_KEY=

# HTTPS本番環境では true（ローカルHTTP開発では false）
SESSION_COOKIE_SECURE=false

# Stripe シークレットキー（サブスク課金用）
STRIPE_SECRET_KEY=

# Stripe Webhook 署名シークレット（/stripe-webhook の検証用）
STRIPE_WEBHOOK_SECRET=

# Stripe 月額プランのPrice ID（例: price_...）
STRIPE_PRICE_ID=

# 公開ページへのリンク
# GUIDE_URL / TERMS_URL / PRIVACY_URL が未設定の場合は、アプリ内ページを表示します。
# その他の未設定項目はアプリ画面に表示されません。
GUIDE_URL=
TERMS_URL=
PRIVACY_URL=
CANCELLATION_POLICY_URL=
SUPPORT_URL=

# アプリの待受ポート（未設定時は 5055）
PORT=
